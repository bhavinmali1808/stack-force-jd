# ── Local Development Config ────────────────────
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5174

# ── MongoDB ──────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/resuming_mail

# ── Redis ─────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── JWT ───────────────────────────────────────
JWT_SECRET=local_dev_secret_key_1234567890_resuming_mail
JWT_EXPIRES_IN=7d

# ── SMTP ──────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
FROM_NAME=Resuming.io
FROM_EMAIL=no-reply@resuming.io
TEAMS_EMAIL=teams@resuming.io

# ── Tracking ──────────────────────────────────
TRACKING_BASE_URL=http://localhost:3001

# ── Email Worker ──────────────────────────────
EMAIL_RATE=10
EMAIL_CONCURRENCY=5

# ── Admin Seed ────────────────────────────────
ADMIN_EMAIL=admin@resuming.io
ADMIN_PASSWORD=admin123
