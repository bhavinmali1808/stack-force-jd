# ── Server Config ────────────────────────────
NODE_ENV=production
PORT=3001
CLIENT_URL=https://mail.resuming.io

# ── MongoDB ──────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/resuming_mail

# ── Redis ─────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────
JWT_SECRET=change_this_to_a_random_64char_secret
JWT_EXPIRES_IN=7d

# ── SMTP (Postfix on this VPS) ────────────────
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
FROM_NAME=Resuming.io
FROM_EMAIL=noreply@resuming.io

# ── Tracking ──────────────────────────────────
# Base URL used for open-pixel + click-wrap links
TRACKING_BASE_URL=https://mail.resuming.io

# ── Email Worker ──────────────────────────────
# Emails per second (10 | 20 | 50)
EMAIL_RATE=10
EMAIL_CONCURRENCY=5

# ── Admin Seed (used on first run) ───────────
ADMIN_EMAIL=admin@resuming.io
ADMIN_PASSWORD=change_this_password
